.profile-card {
  padding: 36rpx 32rpx 28rpx;
}

.profile-top {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.avatar-btn {
  padding: 0;
  margin: 0;
  background: transparent;
  border: none;
  line-height: 1;
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  overflow: hidden;
}

.avatar-btn::after {
  border: none;
}

.avatar {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  display: block;
}

.avatar-ph {
  background: #0F6E56;
  color: #ffffff;
  font-size: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nick-input {
  margin-top: 20rpx;
  font-size: 32rpx;
  font-weight: 500;
  text-align: center;
  min-height: 48rpx;
}

.nick-ph {
  color: #B4B2A9;
  font-weight: 400;
}

.profile-stats {
  display: flex;
  align-items: center;
  margin-top: 36rpx;
  padding-top: 28rpx;
  border-top: 1rpx solid #F0F1F1;
}

.ps-item {
  flex: 1;
  text-align: center;
}

.ps-num {
  font-size: 44rpx;
  font-weight: 500;
}

.ps-label {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #888780;
}

.ps-divider {
  width: 1rpx;
  height: 56rpx;
  background: #F0F1F1;
}

.win-lose {
  margin-top: 24rpx;
  text-align: center;
  font-size: 26rpx;
  color: #888780;
}

.save-row {
  margin-top: 24rpx;
}

.save-btn {
  padding: 16rpx 0;
  font-size: 28rpx;
}

.btn-row {
  display: flex;
  justify-content: space-between;
  margin: 32rpx 24rpx 0;
}

.btn.big {
  width: 48%;
  padding: 26rpx 0;
  font-size: 32rpx;
  box-sizing: border-box;
}

.btn.ghost.big {
  background: #ffffff;
  color: #0F6E56;
  border: 1rpx solid #0F6E56;
}

.code-row {
  display: flex;
  align-items: center;
  margin: 24rpx 24rpx 0;
}

.code-input {
  flex: 1;
  background: #ffffff;
  border-radius: 12rpx;
  padding: 22rpx 28rpx;
  font-size: 32rpx;
  letter-spacing: 6rpx;
}

.code-go {
  width: 160rpx;
  margin-left: 20rpx;
  padding: 22rpx 0;
  font-size: 30rpx;
}

.tips {
  margin: 40rpx 40rpx 0;
  font-size: 24rpx;
  color: #B4B2A9;
  line-height: 1.8;
  text-align: center;
}
