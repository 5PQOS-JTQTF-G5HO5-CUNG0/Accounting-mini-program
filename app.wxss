page {
  background: #F6F7F8;
  font-size: 28rpx;
  color: #1F2937;
  font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
}

.card {
  background: #ffffff;
  border-radius: 16rpx;
  margin: 20rpx 24rpx;
  padding: 28rpx;
}

.btn {
  border-radius: 12rpx;
  text-align: center;
  padding: 22rpx 0;
  font-size: 30rpx;
}

.btn.primary {
  background: #0F6E56;
  color: #ffffff;
}

.btn.ghost {
  background: #EEF1F0;
  color: #333333;
}

.btn.half {
  width: 44%;
  display: inline-block;
}

.pos {
  color: #D93025;
}

.neg {
  color: #0F8A43;
}

.badge {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

.badge-on {
  background: #E1F5EE;
  color: #0F6E56;
}

.badge-off {
  background: #EEF1F0;
  color: #888780;
}

.section-title {
  font-size: 26rpx;
  color: #888780;
  margin: 32rpx 32rpx 4rpx;
}

.empty {
  text-align: center;
  color: #888780;
  padding: 120rpx 40rpx;
  line-height: 2;
}

.mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal {
  background: #ffffff;
  width: 88%;
  border-radius: 24rpx;
  padding: 36rpx;
  box-sizing: border-box;
}

.m-title {
  font-size: 34rpx;
  font-weight: 500;
  text-align: center;
  margin-bottom: 28rpx;
}

.m-sub {
  font-size: 26rpx;
  color: #888780;
  margin: 24rpx 0 12rpx;
}

.m-input {
  background: #F6F7F8;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 30rpx;
}

.m-btns {
  margin-top: 36rpx;
  display: flex;
  justify-content: space-between;
}

.m-btns .half {
  width: 48%;
}
